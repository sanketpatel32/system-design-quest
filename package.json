{
  "name": "system-design-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagrams": "node scripts/diagrams/build-diagrams.mjs",
    "audit": "node scripts/assemble-authored.mjs && node scripts/audit-content.mjs",
    "audit:strict": "npm run content:build && AUDIT_STRICT=1 node scripts/audit-content.mjs",
    "content:build": "python3 scripts/authoring/rebuild.py && npm run audit",
    "e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "content:fix": "python3 scripts/authoring/rebuild.py && node scripts/assemble-authored.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/react": "^6.17.8",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "idb": "^8.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.81.0",
    "roughjs": "^4.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
